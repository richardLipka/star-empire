      "relay": {
        "name": "Údržba relé",
        "desc": "Jak rychle obnovit zničené relé."
      },
      "autonomy": {
        "name": "Autonomie",
        "desc": "Kolik volnosti má guvernér. Pevná ruka dráždí vzdálené kolonie; široká autonomie zmírňuje odcizení, ale guvernér pak přehlíží rozkazy s nízkou prioritou. Tento rozkaz přijmou i autonomní kolonie."
      },
      "missions": {
        "name": "Kulturní mise",
        "desc": "Vysílat kulturní mise (písně, archivy, vyslance) do nejméně věrných kolonií, o kterých hlavní město ví. Každá obnoví velkou část věrnosti kolonie. Vyžaduje kulturní mise."
      }
