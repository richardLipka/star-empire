  "directive": {
    "expansion": {
      "explore": {
        "name": "Průzkum",
        "desc": "Vysílat průzkumníky k nejbližším neprozkoumaným systémům. Nesou modul relé, hlásí se z místa příletu a pak letí dál."
      },
      "settle": {
        "name": "Osídlit",
        "desc": "Vysílat kolonizační lodě. „Nejobyvatelnější“ a „nejbohatší“ berou v úvahu jen prozkoumané soustavy. Lodě stojí materiál: embryonální lodě jsou levné, ale vychovají podivné, nestálé společnosti; archy nesou tisíce lidí po staletí; kryospáči přiletí jako ustálený národ."
      },
      "prepare": {
        "name": "Připravit místa",
        "desc": "Vyslat robotické výsadky před kolonisty, aby v prozkoumaných prázdných soustavách postavily habitaty, porodnice a pole. Kolonisté na připraveném místě rostou rychleji, lépe jedí a méně trpí; embryonální lodě tam letí nalehko. Roboti mohou selhat, často beze slova, a kolonisté pak přistanou na nepřipraveném světě. Vyžaduje robotiku výsadků."
      }
    },
    "military": {
      "readiness": {
        "name": "Pohotovost",
        "desc": "Trvalý vojenský stav. Opevněné systémy obnovují relé dvakrát rychleji."
      },
      "warships": {
        "name": "Stavba válečných lodí",
        "desc": "Udržovat zde domácí stráž válečných lodí nejsilnější konstrukce, kterou loděnice umí postavit a zaplatit: žádná, obranná (2), stálá (5) nebo válečná (10). Jedna loď ročně."
      }
    },
    "fleet": {
      "send": {
        "name": "Vyslat flotilu",
        "desc": "Po příchodu rozkazu vyslat jednu flotilu z cílového systému do určeného místa."
      },
      "build": {
        "name": "Postavit lodě",
        "desc": "Postavit v této soustavě lodě dané konstrukce do nové flotily. Konstrukce cestuje v rozkazu; loděnice potřebuje všechny technologie, které používá. Co teď nelze zaplatit, se postaví, jakmile přibude materiál."
      }
    },
    "logistics": {
      "courier": {
        "name": "Kurýrní lety",
        "desc": "Pravidelné kurýrní lodě do cíle a zpět, vozí zprávy a čekající hlášení."
      },
      "deliver": {
        "name": "Doprava",
        "desc": "Převézt zásoby, kolonisty, vybavení nebo artefakty do jiného systému."
