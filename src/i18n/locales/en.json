  "directive": {
    "expansion": {
      "explore": {
        "name": "Explore",
        "desc": "Send scouts to the nearest unexplored systems. Scouts carry a relay module and report from where they arrive, then hop on."
      },
      "settle": {
        "name": "Settle",
        "desc": "Send colony ships. 'Most habitable' and 'richest' consider only surveyed systems. Ships cost materiel: embryo ships are cheap but raise strange, unstable societies; arks carry thousands for centuries; cryo sleepers arrive as a settled people."
      },
      "prepare": {
        "name": "Prepare sites",
        "desc": "Send robotic seeders ahead of the colonists to build habitats, nurseries and fields at surveyed, empty systems. Colonists on a prepared site grow faster, eat better and suffer less; embryo ships sent there travel light. Robots can fail, often without a word, and colonists then land on an unprepared world. Needs seeder robotics."
      }
    },
    "military": {
      "readiness": {
        "name": "Readiness",
        "desc": "Standing military posture. Fortified systems rebuild their relay twice as fast."
      },
      "warships": {
        "name": "Warship construction",
        "desc": "How many warships to build."
      }
    },
    "fleet": {
      "send": {
        "name": "Send fleet",
        "desc": "Launch one fleet from the target system to a destination when the order arrives."
      }
    },
    "logistics": {
      "courier": {
        "name": "Courier runs",
        "desc": "Regular courier ships to a destination and back, carrying news and waiting messages."
      },
      "deliver": {
        "name": "Deliver",
        "desc": "Carry supplies, colonists, equipment or artefacts to another system."
      }
    },
    "governance": {
      "reporting": {
        "name": "Reporting",
        "desc": "How often the system reports. Silent systems send nothing (they still receive)."
      },
      "relay": {
        "name": "Relay maintenance",
        "desc": "How quickly a destroyed relay is rebuilt."
      },
      "autonomy": {
        "name": "Autonomy",
        "desc": "How much freedom the governor has. Tight control chafes distant colonies; broad autonomy eases the drift, but the governor then ignores low-priority orders. Even autonomous colonies accept this order."
      },
      "missions": {
        "name": "Cultural missions",
        "desc": "Send cultural missions (songs, archives, envoys) to the least loyal colonies the capital knows of. Each restores much of a colony's loyalty. Needs cultural missions."
      }
    },
    "economy": {
